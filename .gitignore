# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example는 실제 값이 없는 템플릿이라 예외적으로 커밋 대상)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ignore test pages
/src/app/components-test/

# playwright e2e
/test-results/
/playwright-report/
/e2e/.auth/

# 로컬 전용 메모(직접 테스트한 결과·스크린샷 등, 커밋 대상 아님)
/docs/local전용/
/docs/testing/
