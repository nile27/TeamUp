# Database config
DATABASE_URL=
DIRECT_URL=

# Supabase config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# E2E 테스트가 만드는 Auth 고아 계정을 정리할 때만 필요 (e2e/global.teardown.ts).
# Supabase 대시보드 → Project Settings → API → service_role 키.
# ⚠️ 절대 클라이언트에 노출 금지, NEXT_PUBLIC_ 접두사 쓰지 말 것. GitHub Actions에서는 Secrets로 주입.
SUPABASE_SERVICE_ROLE_KEY=

# 배포된 사이트의 실제 URL (소셜 로그인 콜백 리다이렉트에 사용).
# 로컬 개발에서는 비워두면 http://localhost:3000로 자동 대체됨.
# Vercel 배포 시 프로덕션 도메인으로 설정 (예: https://teamup.vercel.app)
NEXT_PUBLIC_SITE_URL=
